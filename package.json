{
  "name": "cracking-problems-hub-site",
  "version": "1.0.0",
  "private": true,
  "description": "Live dashboard for the Cracking Problems Hub — reads the repo and GitHub, renders the frontier",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "draw": "node scripts/build.mjs --draw",
    "start": "node server.mjs",
    "dev": "node scripts/build.mjs && node server.mjs",
    "rebuild-loop": "node scripts/build.mjs && (node server.mjs)"
  },
  "dependencies": {
    "sirv": "^3.0.0"
  }
}
